C	----------------------------------------------------------------
C	SSV COMPOOL definition
C	----------------------------------------------------------------
C	INTEGER:
C	SINGLE => 16b
C	DOUBLE => 32b
C	SCALAR:
C	SINGLE => 32b
C	DOUBLE => 64b
C
C
C	STRUCTURE for display strings and coordinates
	STRUCTURE DISPCHAR:
	1 TXT CHARACTER(4),
	1 X SCALAR SINGLE,
	1 Y SCALAR SINGLE;
C
C
C	STRUCTURE ICC buffers
	STRUCTURE ICC_BUF:
C	Indicate SIP Cycle Overrun
	1 CZ2B_OVERRUN_IND INTEGER SINGLE,
C	ICC Buffer Flags (VT WD)
	1 CZ2B_STATUS INTEGER SINGLE,
C	% CPU Utilization
	1 CZ2V_DUTY_CYCLE INTEGER DOUBLE,
C	Sum Word
	1 CZ2V_SUM_WD INTEGER DOUBLE,
C	Yields SUMWORD ICC X If Miscompares Occur
	1 CZ2V_SSW_SUMWORD INTEGER SINGLE,
C	Length of Variable ICC Message
	1 CZ2V_VAR_BUF_LENGTH INTEGER SINGLE,
C	Discrete Input A 1st HWD
	1 CZ2B_DIA1 INTEGER SINGLE,
C	Discrete Input A 2nd HWD
	1 CZ2B_DIA2 INTEGER SINGLE,
C	Discrete Input B 1st HWD
	1 CZ2B_DIB1 INTEGER SINGLE,
C	Discrete Input B 2nd HWD
	1 CZ2B_DIB2 INTEGER SINGLE,
C	usec Of GPC GMT Clock
	1 CZ2B_GPC_MT INTEGER DOUBLE,
C	1/2 Hrs Of GPC GMT
	1 CZ2B_GPC_MT2 INTEGER SINGLE,
C	GE & DK Data Path Indications
	1 CZ2B_DK_GSE_DP INTEGER SINGLE,
C	Major Function Display Code
	1 CZ2V_MF_DPS INTEGER DOUBLE,
C	OPS Display Code
	1 CZ2B_OPS_DPS INTEGER DOUBLE,
C	Data Path Status:
C	1st HWD - Primary + SRB
C	2nd HWD - Secondary + MCIU
	1 CZ2B_DP_DISP INTEGER DOUBLE,
C	NSP Data
	1 CZ2B_NSP_BUFFER ARRAY(36) INTEGER SINGLE,
C	Times Used By FPMMTURM
	1 CZ2B_MTU_BUFFER ARRAY(14) INTEGER SINGLE,
C	ICC Errors Dectected
	1 CZ2B_ICC_ERROR_BUS_MSK INTEGER SINGLE,
C	Variable ICC Message Buffer
	1 CZ2V_ICC_MSG_BUF ARRAY(50) INTEGER SINGLE,
C	Variable ICC Message's Checksum
	1 CZ2V_ICC_CKSUM INTEGER SINGLE;
C
C
C	STRUCTURE for Computer CRT Assignment Table
	STRUCTURE CCATS:
C	GPC to Command DEU upon selections of PL, GNC or SM Major Function. (CZ2VCCAT)
C	0 - DEU-1
C	1 - DEU-2
C	2 - DEU-3
C	3 - DEU-4
	1 CZ2V_CCAT ARRAY(4) INTEGER SINGLE;
C
C
C	STRUCTURE for GPC Status Table
	STRUCTURE GST:
C	FCOS Computed % of CPU Utilization (TGSTDUTY, CZ2VGST1, CZ2VGST2, CZ2VGST3, CZ2VGST4, CZ2VGST5) [%]
	1 CZ2V_DUTY_CYCLE ARRAY(5) SCALAR SINGLE,
C	Current OPS for Each MF (PL, GN, SM respectively) (TGSTPOPS, TGSTGOPS, TGSTSOPS)
	1 CZ2V_CURRENT_OPS ARRAY(3) INTEGER SINGLE,
C	Program Overlay Number Currently Resident (TGSTPGOV)
	1 CZ2V_PROG_OVLY INTEGER SINGLE,
C	Major Function Currently Resident (TGSTMFOV)
	1 CZ2V_MF_OVLY INTEGER SINGLE,
C	Memory Configuration Number Currently Resident
	1 CZ2V_MC INTEGER SINGLE,
C	Mask Of Actual IOP Transmitter State For Buses 1-15 Beginning With Bit 2 (TGTTCCT)
	1 CZ2B_ACT_XMITR1 INTEGER SINGLE,
C	Mask Of Actual IOP Transmitter State For Buses 16-24 Beginning With Bit 1
	1 CZ2B_ACT_XMITR2 INTEGER SINGLE,
C	Mask Of Actual IOP Receiver State For Buses 1-24 Beginning With Bit 2 (TGSTTCCR)
	1 CZ2B_ACT_RECVR INTEGER SINGLE,
C	Mask Of I/O Buses 1-15 For Which I/O Is To Be Inhibited Beginning With Bit 2
	1 CZ2B_BUS_MASK1 INTEGER SINGLE,
C	Mask Of I/O Buses 16-24 For Which I/O Is To Be Inhibited Beginning With Bit 1
	1 CZ2B_BUS_MASK2 INTEGER SINGLE,
C	Mask Of Data Paths Including Buses 10-23 For ??? 11-17 Beginning With Bit 1 (TGSTDPM)
	1 CZ2B_DPM ARRAY(7) INTEGER SINGLE,
C	Common Set Mask Beginning With Bit 12 For GPC I Where Other Members Of Set Are Represented By A 1 Bit (TGSTCSM)
C	0 - GPC-5
C	1 - GPC-4
C	2 - GPC-3
C	3 - GPC-2
C	4 - GPC-1
	1 CZ2B_CS INTEGER SINGLE,
C	Redundant Set Mask Beginning With Bit 12 For GPC I Where Other Members Of Set Are Represented By A 1 Bit (TGSTRSM)
C	0 - GPC-5
C	1 - GPC-4
C	2 - GPC-3
C	3 - GPC-2
C	4 - GPC-1
	1 CZ2B_RS INTEGER SINGLE,
C	GST Status Flags. Bits 1, 2, 6-8 Not Used (TGSTIND)
C	0-2 - TIME_SOURCE: Time Source For Management. MTU1 - 1; MTU2 - 2; MTU3 - 3; GPCPT - 4; GPCMT - 5;
C	3 - CAM_STATUS_VOTES: Set Of This GPC's Votes Against Other GPCs In RS - GPC-5
C	4 - CAM_STATUS_VOTES: Set Of This GPC's Votes Against Other GPCs In RS - GPC-4
C	5 - CAM_STATUS_VOTES: Set Of This GPC's Votes Against Other GPCs In RS - GPC-3
C	6 - CAM_STATUS_VOTES: Set Of This GPC's Votes Against Other GPCs In RS - GPC-2
C	7 - CAM_STATUS_VOTES: Set Of This GPC's Votes Against Other GPCs In RS - GPC-1
C	11 - OVERLAY_IN_PROGRESS_FLAG: Reconfiguration Of RS Or Main Memory In Progress
C	12 - DOWNLIST_FORMATTER_ENABLED_FLAG: Downlist Formatter Enabled
C	13 - DUTY_CYCLE_HIGH_FLAG: Duty Cycle Exceeds Duty Cycle High Limit
	1 CZ2B_STATUS INTEGER SINGLE,
C	Major Function Display Character Code For Each Of Two Lines Provided On The DPS CM Page. PL - P; GNC - G; SM - S (TGSTMFD)
	1 CZ2V_MF_DPS CHARACTER(2),
C	OPS Number Display Code For Each Of Two Lines Provided On The DPS CM Page. Bits 1-12 Not Used
	1 CZ2B_OPS_DPS ARRAY(2) INTEGER SINGLE,
C	Data Path Controller For FC, PL, And LD Buses (TGSTDPD)
	1 CZ2B_DP_DISP ARRAY(2) INTEGER SINGLE,
C	Data Path Controller For DK And GSE Buses
	1 CZ2B_DK_GSE_DP INTEGER SINGLE;
C
C
C
C	GPC_ID
	DECLARE TFCMID INTEGER SINGLE;
C	current major mode
	DECLARE MM INTEGER SINGLE;
C
C
C	ICC
C	ICC Message Table
	DECLARE CZ2V_ICC_MSG_TAB ARRAY(28) INTEGER SINGLE;
C	ICC status flags
	DECLARE CZ2B_ICC_FLAG ARRAY(3) INTEGER SINGLE;
C	ICC_Buffer_Pointer
	DECLARE CZ2V_ICC_BUF_POINT INTEGER SINGLE;
C	ICC_Messages
	DECLARE CZ2V_ICC_BUF ICC_BUF-STRUCTURE(5);
C
C
C	Prime GPC ID (CZ2VGPCP)
	DECLARE CZ2V_GPC_P INTEGER SINGLE;
C
C	DK bus commander mask (1-commander)
	DECLARE DK_CMDR_MASK INTEGER SINGLE;
C
C
C	Computer CRT Assignment Table
	DECLARE CZ2V_CCATS CCATS-STRUCTURE(3);
C
C
C	GPC Status Table
	DECLARE CZ2V_GST GST-STRUCTURE(5);
C
C
C	Fresh Input Of Discrete Input Register A (TIOODIAL, CZ2B_DIA2, TIOODIA2)
	DECLARE CZ2B_DIA1 INTEGER SINGLE;
C
C
C	CRT SPEC
C	0 - CRT-1
C	1 - CRT-2
C	2 - CRT-3
C	3 - CRT-4
	DECLARE CRT_SPEC ARRAY(4) INTEGER SINGLE;
C
C	CRT DISP
C	0 - CRT-1
C	1 - CRT-2
C	2 - CRT-3
C	3 - CRT-4
	DECLARE CRT_DISP ARRAY(4) INTEGER SINGLE;
C
C	DEU FCW buffer for output
	DECLARE DMC_DEU_BUF ARRAY(511) INTEGER SINGLE;
C	DEU FCW count
C	DECLARE DMC_DEU_BUF_COUNT INTEGER SINGLE;
C
C
C	MDM return word output
	DECLARE MDM_RETURN INTEGER SINGLE;
