<Window x:Class="SSVMissionEditor.ViewPayloadBay"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="View Payload Bay" Height="785" Width="1275" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
	<Window.Background>
		<SolidColorBrush Color="#FFF9F9F9"/>
	</Window.Background>
	<Window.CommandBindings>
		<CommandBinding Command="Close" Executed="CommandBinding_Executed"/>
	</Window.CommandBindings>
	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="Close"/>
	</Window.InputBindings>
	<Grid>
		<Label x:Name="lblStarboard" HorizontalAlignment="Left" Height="45" Margin="10,70,0,0" VerticalAlignment="Top" Width="75">
			<AccessText TextWrapping="Wrap" Text="Starboard Longeron"/>
		</Label>
		<Label x:Name="lblKeel" Content="Keel" HorizontalAlignment="Left" Height="25" Margin="10,685,0,0" VerticalAlignment="Top" Width="45"/>
		<Label x:Name="lblPort" HorizontalAlignment="Left" Height="45" Margin="10,340,0,0" VerticalAlignment="Top" Width="75">
			<AccessText TextWrapping="Wrap" Text="Port Longeron"/>
		</Label>

		<Label x:Name="lblBay1" Content="Bay 1" HorizontalAlignment="Left" Height="25" Margin="128,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay2" Content="Bay 2" HorizontalAlignment="Left" Height="25" Margin="218,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay3" Content="Bay 3" HorizontalAlignment="Left" Height="25" Margin="305,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay4" Content="Bay 4" HorizontalAlignment="Left" Height="25" Margin="392,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay5" Content="Bay 5" HorizontalAlignment="Left" Height="25" Margin="479,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay6" Content="Bay 6" HorizontalAlignment="Left" Height="25" Margin="568,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay7" Content="Bay 7" HorizontalAlignment="Left" Height="25" Margin="658,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay8" Content="Bay 8" HorizontalAlignment="Left" Height="25" Margin="746,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay9" Content="Bay 9" HorizontalAlignment="Left" Height="25" Margin="830,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay10" Content="Bay 10" HorizontalAlignment="Left" Height="25" Margin="915,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay11" Content="Bay 11" HorizontalAlignment="Left" Height="25" Margin="983,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay12" Content="Bay 12" HorizontalAlignment="Left" Height="25" Margin="1064,20,0,0" VerticalAlignment="Top" Width="50"/>
		<Label x:Name="lblBay13" Content="Bay 13" HorizontalAlignment="Left" Height="25" Margin="1150,20,0,0" VerticalAlignment="Top" Width="50"/>

		<Canvas x:Name="cnvPLB" HorizontalAlignment="Left" Height="670" Margin="80,50,0,0" VerticalAlignment="Top" Width="1155" Background="White"/>
	</Grid>
</Window>
