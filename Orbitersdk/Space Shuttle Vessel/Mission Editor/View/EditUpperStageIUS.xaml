<Window x:Class="SSVMissionEditor.EditUpperStageIUS"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Edit IUS" Height="430" Width="550" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
	<Window.Background>
		<SolidColorBrush Color="#FFF9F9F9"/>
	</Window.Background>
	<Window.CommandBindings>
		<CommandBinding Command="Close" Executed="CommandBinding_Executed" />
	</Window.CommandBindings>
	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="Close" />
	</Window.InputBindings>
	<Grid>
		<Label Content="Name" HorizontalAlignment="Left" Height="25" Margin="10,10,0,0" VerticalAlignment="Top" Width="50"/>
		<TextBox x:Name="txtLargeUpperStage_Name" HorizontalAlignment="Left" Height="24" Margin="60,10,0,0" Text="{Binding LargeUpperStage_Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="200"/>

		<Label Content="Texture" HorizontalAlignment="Left" Height="25" Margin="10,40,0,0" VerticalAlignment="Top" Width="50"/>
		<TextBox x:Name="txtIUSTexture" HorizontalAlignment="Left" Height="24" Margin="60,40,0,0" Text="{Binding IUS_Texture, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="200"/>

		<GroupBox x:Name="frmLatches" Header="Latches" HorizontalAlignment="Left" Height="90" Margin="280,10,0,0" VerticalAlignment="Top" Width="250">
			<Grid>
				<Label Content="Port" HorizontalAlignment="Left" Height="26" Margin="10,5,0,0" VerticalAlignment="Top" Width="85"/>
				<Label Content="Starboard" HorizontalAlignment="Left" Height="26" Margin="128,5,0,0" VerticalAlignment="Top" Width="85"/>

				<ComboBox x:Name="cmbLatchPort" HorizontalAlignment="Left" Height="25" Margin="10,31,0,0" VerticalAlignment="Top" Width="100" SelectedIndex="{Binding OV.LargeUpperStage_Latch[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<ComboBoxItem Content="P/L 1 Latch 1"/>
					<ComboBoxItem Content="P/L 1 Latch 2"/>
					<ComboBoxItem Content="P/L 1 Latch 3"/>
					<ComboBoxItem Content="P/L 1 Latch 4"/>
					<ComboBoxItem Content="P/L 1 Latch 5"/>
					<ComboBoxItem Content="P/L 2 Latch 1"/>
					<ComboBoxItem Content="P/L 2 Latch 2"/>
					<ComboBoxItem Content="P/L 2 Latch 3"/>
					<ComboBoxItem Content="P/L 2 Latch 4"/>
					<ComboBoxItem Content="P/L 2 Latch 5"/>
					<ComboBoxItem Content="P/L 3 Latch 1"/>
					<ComboBoxItem Content="P/L 3 Latch 2"/>
					<ComboBoxItem Content="P/L 3 Latch 3"/>
					<ComboBoxItem Content="P/L 3 Latch 4"/>
					<ComboBoxItem Content="P/L 3 Latch 5"/>
				</ComboBox>

				<ComboBox x:Name="cmbLatchStbd" HorizontalAlignment="Left" Height="25" Margin="128,31,0,0" VerticalAlignment="Top" Width="100" SelectedIndex="{Binding OV.LargeUpperStage_Latch[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<ComboBoxItem Content="P/L 1 Latch 1"/>
					<ComboBoxItem Content="P/L 1 Latch 2"/>
					<ComboBoxItem Content="P/L 1 Latch 3"/>
					<ComboBoxItem Content="P/L 1 Latch 4"/>
					<ComboBoxItem Content="P/L 1 Latch 5"/>
					<ComboBoxItem Content="P/L 2 Latch 1"/>
					<ComboBoxItem Content="P/L 2 Latch 2"/>
					<ComboBoxItem Content="P/L 2 Latch 3"/>
					<ComboBoxItem Content="P/L 2 Latch 4"/>
					<ComboBoxItem Content="P/L 2 Latch 5"/>
					<ComboBoxItem Content="P/L 3 Latch 1"/>
					<ComboBoxItem Content="P/L 3 Latch 2"/>
					<ComboBoxItem Content="P/L 3 Latch 3"/>
					<ComboBoxItem Content="P/L 3 Latch 4"/>
					<ComboBoxItem Content="P/L 3 Latch 5"/>
				</ComboBox>
			</Grid>
		</GroupBox>

		<CheckBox x:Name="ckIUSAftPosition" Content="Aft Position" HorizontalAlignment="Left" Height="20" Margin="37,80,0,0" VerticalAlignment="Top" Width="85" IsChecked="{Binding OV.IUS_AftPosition, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckIUS4Antennas" Content="4 Antennas" HorizontalAlignment="Left" Height="20" Margin="159,80,0,0" VerticalAlignment="Top" Width="85" IsChecked="{Binding IUS_4Antennas, UpdateSourceTrigger=PropertyChanged}"/>

		<GroupBox x:Name="frmPerf" Header="Performance" HorizontalAlignment="Left" Height="270" Margin="10,115,0,0" VerticalAlignment="Top" Width="520">
			<Grid>
				<Label Content="1º Stage Load" HorizontalAlignment="Left" Height="26" Margin="10,10,0,0" VerticalAlignment="Top" Width="85"/>
				<Label Content="2º Stage Load" HorizontalAlignment="Left" Height="26" Margin="10,40,0,0" VerticalAlignment="Top" Width="85"/>
				<Label Content="RCS Tanks" HorizontalAlignment="Left" Height="26" Margin="30,90,0,0" VerticalAlignment="Top" Width="65"/>
				<TextBox x:Name="txtLoad1Stage" HorizontalAlignment="Left" Height="20" Margin="100,10,0,0" Text="{Binding IUS_1StageLoad, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="50"/>
				<TextBox x:Name="txtLoad2Stage" HorizontalAlignment="Left" Height="20" Margin="100,40,0,0" Text="{Binding IUS_2StageLoad, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="50"/>
				<TextBox x:Name="txtRCSTanks" HorizontalAlignment="Left" Height="20" Margin="100,90,0,0" Text="{Binding IUS_RCSTanks, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="25"/>

				<Label Content="Current Alt." HorizontalAlignment="Left" Height="26" Margin="175,43,0,0" VerticalAlignment="Top" Width="85" ToolTip="km"/>
				<Label Content="Target Alt." HorizontalAlignment="Left" Height="26" Margin="175,68,0,0" VerticalAlignment="Top" Width="85" ToolTip="km"/>
				<Label Content="ΔInc. SRM-1" HorizontalAlignment="Left" Height="26" Margin="175,93,0,0" VerticalAlignment="Top" Width="85" ToolTip="deg"/>
				<Label Content="ΔInc. SRM-2" HorizontalAlignment="Left" Height="26" Margin="175,118,0,0" VerticalAlignment="Top" Width="85" ToolTip="deg"/>
				<Label Content="Target C3" HorizontalAlignment="Left" Height="26" Margin="175,143,0,0" VerticalAlignment="Top" Width="85" ToolTip="km^2/s^2"/>
				<Label Content="Payload Mass" HorizontalAlignment="Left" Height="26" Margin="175,168,0,0" VerticalAlignment="Top" Width="85" ToolTip="kg"/>
				<TextBox x:Name="txtAltcur" HorizontalAlignment="Left" Height="20" Margin="265,46,0,0" TextWrapping="Wrap" Text="296" VerticalAlignment="Top" Width="60"/>
				<TextBox x:Name="txtAlttgt" HorizontalAlignment="Left" Height="20" Margin="265,71,0,0" TextWrapping="Wrap" Text="35786" VerticalAlignment="Top" Width="60"/>
				<TextBox x:Name="txtdInc1" HorizontalAlignment="Left" Height="20" Margin="265,96,0,0" TextWrapping="Wrap" Text="1.45" VerticalAlignment="Top" Width="60"/>
				<TextBox x:Name="txtdInc2" HorizontalAlignment="Left" Height="20" Margin="265,121,0,0" TextWrapping="Wrap" Text="27" VerticalAlignment="Top" Width="60"/>
				<TextBox x:Name="txtC3tgt" HorizontalAlignment="Left" Height="20" Margin="265,146,0,0" TextWrapping="Wrap" Text="25" VerticalAlignment="Top" Width="60"/>
				<TextBox x:Name="txtPLmass" HorizontalAlignment="Left" Height="20" Margin="265,171,0,0" TextWrapping="Wrap" Text="2268" VerticalAlignment="Top" Width="60"/>
				<Button x:Name="cmdCalc" Content="Calc" HorizontalAlignment="Left" Height="24" Margin="180,210,0,0" VerticalAlignment="Top" Width="70" Click="CmdCalc_Click"/>
				<Button x:Name="cmdSave" Content="Save" HorizontalAlignment="Left" Height="24" Margin="260,210,0,0" VerticalAlignment="Top" Width="70" Click="CmdSave_Click"/>
				<TextBox x:Name="txtResult" HorizontalAlignment="Left" Height="225" Margin="338,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="155"/>
				<RadioButton x:Name="radOrbital" Content="Orbital" HorizontalAlignment="Left" Margin="185,15,0,0" VerticalAlignment="Top" Checked="radOrbital_Checked"/>
				<RadioButton x:Name="radEscape" Content="Escape" HorizontalAlignment="Left" Margin="255,15,0,0" VerticalAlignment="Top" Checked="radEscape_Checked"/>
			</Grid>
		</GroupBox>
	</Grid>
</Window>
