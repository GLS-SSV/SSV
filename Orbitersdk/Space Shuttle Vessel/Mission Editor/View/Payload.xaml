<UserControl x:Class="SSVMissionEditor.Payload"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d" 
	d:DesignHeight="500" d:DesignWidth="975">
	<Grid>
		<ListView HorizontalAlignment="Left" Height="420" Margin="20,20,0,0" ItemsSource="{Binding Payload_PayloadList}" SelectedItem="{Binding Payload_SelectedPayload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Single" VerticalAlignment="Top" Width="930">
			<ListView.View>
				<GridView>
					<!--<GridViewColumn Header="Idx" Width="30">
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Idx}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>-->
					<GridViewColumn Header="Type" Width="150">
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Type}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>
					<GridViewColumn Header="Payload Name" Width="150">
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Payload.Name}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>
					<GridViewColumn Header="Vessel Class" Width="150">
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Payload.VesselClass}"/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>
				</GridView>
			</ListView.View>
		</ListView>
		<ComboBox x:Name="cbPLType" HorizontalAlignment="Left" Margin="40,450,0,0" VerticalAlignment="Top" Height="24" Width="170" ItemsSource="{Binding Payload_AddPayloadType_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Payload_AddPayloadType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<Button x:Name="btnAddPL" Content="Add PL" HorizontalAlignment="Left" Height="25" Margin="220,450,0,0" VerticalAlignment="Top" Width="80" Command="{Binding Payload_AddPayloadCommand}"/>
		<Button x:Name="btnViewPLB" Content="View PLB" HorizontalAlignment="Left" Height="25" Margin="423,450,0,0" VerticalAlignment="Top" Width="80" Command="{Binding Payload_ViewPLBCommand}"/>
		<Button x:Name="btnEditPayload" Content="Edit Payload" HorizontalAlignment="Left" Height="25" Margin="621,450,0,0" VerticalAlignment="Top" Width="80" Command="{Binding Payload_EditPayloadCommand}"/>
		<Button x:Name="btnDeletePL" Content="Delete PL" HorizontalAlignment="Left" Height="25" Margin="844,450,0,0" VerticalAlignment="Top" Width="80" Command="{Binding Payload_DeletePayloadCommand}"/>
	</Grid>
</UserControl>
