<UserControl x:Class="SSVMissionEditor.Launch"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SSVMissionEditor"
	mc:Ignorable="d" 
	d:DesignHeight="500" d:DesignWidth="975">
	<UserControl.Resources>
		<local:Convert_DI x:Key="Convert_DI"/>
	</UserControl.Resources>
	<Grid>
		<Label Margin="25,25,0,0" HorizontalAlignment="Left" Width="100" Height="25" VerticalAlignment="Top">Launch site</Label>
		<ComboBox Name="Site" ItemsSource="{Binding Launch_Site_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Launch_Site, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="130,25,0,0" HorizontalAlignment="Left" Width="120" Height="24" VerticalAlignment="Top"/>

		<Label Margin="25,50,0,0" HorizontalAlignment="Left" Width="100" Height="25" VerticalAlignment="Top">Launch pad</Label>
		<ComboBox Name="Pad" IsEnabled="{Binding Launch_PadMLP_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Launch_Pad_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Launch_Pad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="130,50,0,0" HorizontalAlignment="Left" Width="120" Height="24" VerticalAlignment="Top"/>

		<Label Margin="25,75,0,0" Visibility="{Binding Launch_PadMLP_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Width="100" Height="25" VerticalAlignment="Top">Launch pad type</Label>
		<ComboBox Name="PadType" Visibility="{Binding Launch_PadMLP_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}" ItemsSource="{Binding Launch_PadType_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Launch_PadType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="130,75,0,0" HorizontalAlignment="Left" Width="120" Height="24" VerticalAlignment="Top"/>

		<Label Margin="25,100,0,0" Visibility="{Binding Launch_PadMLP_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Width="100" Height="25" VerticalAlignment="Top">MLP</Label>
		<ComboBox Name="MLP" Visibility="{Binding Launch_PadMLP_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}" ItemsSource="{Binding Launch_MLP_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Launch_MLP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="130,100,0,0" HorizontalAlignment="Left" Width="120" Height="24" VerticalAlignment="Top"/>

		<GroupBox Header="Launch Date/Time" Margin="10,150,0,0" Height="106" Width="285" VerticalAlignment="Top" HorizontalAlignment="Left">
			<Grid Margin="2,0,4,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="70"/>
					<ColumnDefinition Width="61"/>
					<ColumnDefinition Width="79"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="26"/>
					<RowDefinition Height="26"/>
					<RowDefinition Height="26"/>
				</Grid.RowDefinitions>
				<Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Width="33" Content="Year"/>
				<TextBox x:Name="tbYear" Grid.Row="0" Grid.Column="1" Text="{Binding T0Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="4" MaxLines="1"/>
				<Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Width="45" Content="Month"/>
				<TextBox x:Name="tbMonth" Grid.Row="1" Grid.Column="1" Text="{Binding T0Month, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="2" MaxLines="1"/>
				<Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Width="30" Content="Day"/>
				<TextBox x:Name="tbDay" Grid.Row="2" Grid.Column="1" Text="{Binding T0Day, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="2" MaxLines="1"/>
				<Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Width="37" Content="Hour"/>
				<TextBox x:Name="tbHour" Grid.Row="0" Grid.Column="3" Text="{Binding T0Hour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="2" MaxLines="1"/>
				<Label Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Width="48" Content="Minute"/>
				<TextBox x:Name="tbMinute" Grid.Row="1" Grid.Column="3" Text="{Binding T0Minute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="2" MaxLines="1"/>
				<Label Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Width="49" Content="Second"/>
				<TextBox x:Name="tbSecond" Grid.Row="2" Grid.Column="3" Text="{Binding T0Second, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,3,0,0" MaxLength="6" MaxLines="1"/>
			</Grid>
		</GroupBox>

		<GroupBox x:Name="frmAscentTarget" Header="Ascent Target" HorizontalAlignment="Left" Height="475" Margin="330,10,0,0" VerticalAlignment="Top" Width="635">
			<Grid Margin="10,10,10,10">
				<Label Content="Insertion Mode" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,0,0,0"/>
				<ComboBox x:Name="cmbATInsertionMode" SelectedIndex="{Binding Launch_DI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource Convert_DI}}" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="85" Margin="143,0,0,0" SelectionChanged="cmbATInsertionMode_SelectionChanged">
					<ComboBoxItem>Standard</ComboBoxItem>
					<ComboBoxItem>Direct</ComboBoxItem>
				</ComboBox>

				<Label Content="Inclination (deg)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,31,0,0"/>
				<TextBox x:Name="txtATInc" Text="{Binding Launch_MECOInclination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="143,31,0,0" VerticalAlignment="Top" Width="50" MaxLines="1"/>

				<Label Content="MECO Altitude (NM)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,62,0,0"/>
				<ComboBox x:Name="cmbATMECOAlt" ItemsSource="{Binding Launch_cmbATMECOAlt_src, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Launch_MECOAltitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="85" Margin="143,62,0,0"/>

				<Label x:Name="lblMECO_OMS1_Alt" Content="OMS-1 Target Alt (NM)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,93,0,0"/>
				<TextBox x:Name="txtATOMS1MECOTgtAlt" Text="{Binding Launch_OMS1MECOTargetAltitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="143,93,0,0" VerticalAlignment="Top" Width="50" MaxLines="1" TextChanged="txtATOMS1MECOTgtAlt_TextChanged"/>

				<Label Content="OMS-2 Target Alt (NM)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,124,0,0"/>
				<TextBox x:Name="txtATOMS2TgtAlt" Text="{Binding Launch_OMS2TargetAltitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="143,124,0,0" VerticalAlignment="Top" Width="50" MaxLines="1" TextChanged="txtATOMS2TgtAlt_TextChanged"/>

				<CheckBox x:Name="chkATRTHU" Content="Roll To Heads Up" IsChecked="{Binding Launch_RTHU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="245,6,0,0" VerticalAlignment="Top"/>

				<CheckBox x:Name="chkIY" Content="Enable IY" IsChecked="{Binding Launch_IY_ena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,200,0,0" VerticalAlignment="Top"/>
				<CheckBox x:Name="chkEF_PLANE_SW" Content="Earth-Fixed IY" IsChecked="{Binding Launch_EF_PLANE_SW, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Launch_IY_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,220,0,0" VerticalAlignment="Top"/>
				<Label Content="Target IY Plane" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,240,0,0"/>
				<TextBox x:Name="txtIYx" Text="{Binding Launch_IYx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Launch_IY_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="143,240,0,0" VerticalAlignment="Top" Width="60" MaxLines="1"/>
				<TextBox x:Name="txtIYy" Text="{Binding Launch_IYy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Launch_IY_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="208,240,0,0" VerticalAlignment="Top" Width="60" MaxLines="1"/>
				<TextBox x:Name="txtIYz" Text="{Binding Launch_IYz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Launch_IY_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="273,240,0,0" VerticalAlignment="Top" Width="60" MaxLines="1"/>

				<Button x:Name="btnATCalc" Command="{Binding Launch_CalcAscentCommand}" Content="Calculate" HorizontalAlignment="Left" Margin="363,400,0,0" VerticalAlignment="Top" Width="115" Height="30"/>
				<Button x:Name="btnATSave" Command="{Binding Launch_AscentSaveCommand}" Content="Save" HorizontalAlignment="Left" Margin="488,400,0,0" VerticalAlignment="Top" Width="115" Height="30"/>

				<TextBox x:Name="txtATresult" Text="{Binding Launch_ResultString, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="385" Margin="363,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" AllowDrop="False" VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsReadOnlyCaretVisible="True"/>
				<GroupBox Header="SSME Throttle (%)" HorizontalAlignment="Left" Height="100" Margin="0,333,0,0" VerticalAlignment="Top" Width="345">
					<Grid HorizontalAlignment="Left" Height="60" Margin="10,10,0,0" VerticalAlignment="Top" Width="315">
						<TextBox HorizontalAlignment="Left" Height="25" Margin="5,25,0,0" TextWrapping="Wrap" Text="{Binding Launch_SSME_KMIN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLines="1" VerticalAlignment="Top" Width="50"/>
						<TextBox HorizontalAlignment="Left" Height="25" Margin="90,25,0,0" TextWrapping="Wrap" Text="{Binding Launch_SSME_KMAX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLines="1" VerticalAlignment="Top" Width="50"/>
						<TextBox HorizontalAlignment="Left" Height="25" Margin="175,25,0,0" TextWrapping="Wrap" Text="{Binding Launch_SSME_KMAX_ABORT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLines="1" VerticalAlignment="Top" Width="50"/>
						<TextBox HorizontalAlignment="Left" Height="25" Margin="260,25,0,0" TextWrapping="Wrap" Text="{Binding Launch_SSME_KMAX_SEC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLines="1" VerticalAlignment="Top" Width="50"/>
						<Label Content="Minimum" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="65"/>
						<Label Content="Maximum" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="83,0,0,0" VerticalAlignment="Top" Width="65"/>
						<Label Content="Abort" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="167,0,0,0" VerticalAlignment="Top" Width="65"/>
						<Label Content="Secondary" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="250,0,0,0" VerticalAlignment="Top" Width="65"/>
					</Grid>
				</GroupBox>
			</Grid>
		</GroupBox>

		<GroupBox x:Name="frmLegacyMECO" Header="Legacy MECO" HorizontalAlignment="Left" Height="225" Margin="10,260,0,0" VerticalAlignment="Top" Width="300">
			<Grid Margin="10,10,10,10">
				<Label Content="Inclination (deg)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,0,0,0"/>
				<TextBox x:Name="txtMECOInc" Text="{Binding MECO_Inc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="148,0,0,0" VerticalAlignment="Top" Width="120" MaxLines="1"/>

				<Label Content="Altitude (m)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,31,0,0"/>
				<TextBox x:Name="txtMECOAlt" Text="{Binding MECO_Alt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="148,31,0,0" VerticalAlignment="Top" Width="120" MaxLines="1"/>

				<Label Content="Velocity (m/s)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,62,0,0"/>
				<TextBox x:Name="txtMECOVel" Text="{Binding MECO_Vel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="148,62,0,0" VerticalAlignment="Top" Width="120" MaxLines="1"/>

				<Label Content="Flight Path Angle (deg)" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,93,0,0"/>
				<TextBox x:Name="txtMECOFPA" Text="{Binding MECO_FPA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="148,93,0,0" VerticalAlignment="Top" Width="120" MaxLines="1"/>

				<CheckBox x:Name="chkMECOEF_PLANE_SW" Content="Earth-Fixed IY" IsChecked="{Binding MECO_EF_PLANE_SW, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,130,0,0" VerticalAlignment="Top"/>

				<Label Content="IY Plane" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="140" Margin="0,155,0,0"/>
				<TextBox x:Name="txtMECOIY" Text="{Binding MECO_IY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="26" Margin="148,155,0,0" VerticalAlignment="Top" Width="120" MaxLines="1"/>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
