<UserControl x:Class="SSVMissionEditor.OtherVessels"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:uc="clr-namespace:SSVMissionEditor.View"
	mc:Ignorable="d"
	d:DesignHeight="500" d:DesignWidth="975">
	<Grid>
		<uc:EditVessel Vessel="{Binding OtherVessels_Vessel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="508,20,107,260"/>
		<GroupBox Header="Other Vessel List" HorizontalAlignment="Left" Height="205" Margin="20,20,0,0" VerticalAlignment="Top" Width="400">
			<Grid>
				<Button x:Name="btnNew" Command="{Binding OtherVessels_NewVesselCommand}" Content="New" HorizontalAlignment="Left" Height="25" Margin="25,5,0,0" VerticalAlignment="Top" Width="75"/>
				<Button x:Name="btnDelete" Command="{Binding OtherVessels_DeleteVesselCommand}" Content="Delete" HorizontalAlignment="Left" Height="25" Margin="25,35,0,0" VerticalAlignment="Top" Width="75"/>
				<ListBox x:Name="lbxOtherVesselList" HorizontalAlignment="Left" Height="150" Margin="219,10,0,0" VerticalAlignment="Top" Width="150" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding OtherVessels_List}" SelectedItem="{Binding OtherVessels_Vessel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock>
								<Run Text="{Binding Name}"/>
							</TextBlock>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
