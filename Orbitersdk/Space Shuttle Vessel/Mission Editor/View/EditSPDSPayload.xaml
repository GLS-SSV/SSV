<Window x:Class="SSVMissionEditor.EditSPDSPayload"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Edit SPDS Payload" Height="280" Width="640" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
	<Window.Background>
		<SolidColorBrush Color="#FFF9F9F9"/>
	</Window.Background>
	<Window.CommandBindings>
		<CommandBinding Command="Close" Executed="CommandBinding_Executed"/>
	</Window.CommandBindings>
	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="Close"/>
	</Window.InputBindings>
	<Grid x:Name="grdGrid">
		<GroupBox x:Name="frmLatches" Header="Latches" HorizontalAlignment="Left" Height="220" Margin="10,10,0,0" VerticalAlignment="Top" Width="360">
			<Grid>
				<Label x:Name="lblStarboard2" HorizontalAlignment="Left" Height="45" Margin="8,10,0,0" VerticalAlignment="Top" Width="75">
					<AccessText TextWrapping="Wrap" Text="Starboard Longeron"/>
				</Label>
				<Label x:Name="lblKeel2" Content="Keel" HorizontalAlignment="Left" Height="25" Margin="8,70,0,0" VerticalAlignment="Top" Width="75"/>
				<Label x:Name="lblPort2" HorizontalAlignment="Left" Height="45" Margin="8,110,0,0" VerticalAlignment="Top" Width="75">
					<AccessText TextWrapping="Wrap" Text="Port Longeron"/>
				</Label>

				<Button x:Name="cmdEditStbd1" Content="{Binding PLID_S1, Mode=OneWay}" HorizontalAlignment="Left" Margin="108,22,0,0" VerticalAlignment="Top" Width="75" Height="20" Command="{Binding Command_EditLatchCommand}" CommandParameter="S1"/>

				<Button x:Name="cmdEditStbd2" Content="{Binding PLID_S2, Mode=OneWay}" HorizontalAlignment="Left" Margin="258,22,0,0" VerticalAlignment="Top" Width="75" Height="20" Command="{Binding Command_EditLatchCommand}" CommandParameter="S2"/>


				<Button x:Name="cmdEditKeel1" Content="{Binding PLID_K, Mode=OneWay}" HorizontalAlignment="Left" Margin="183,72,0,0" VerticalAlignment="Top" Width="75" Height="20" Command="{Binding Command_EditLatchCommand}" CommandParameter="K"/>


				<Button x:Name="cmdEditPort1" Content="{Binding PLID_P1, Mode=OneWay}" HorizontalAlignment="Left" Margin="108,122,0,0" VerticalAlignment="Top" Width="75" Height="20" Command="{Binding Command_EditLatchCommand}" CommandParameter="P1"/>

				<Button x:Name="cmdEditPort2" Content="{Binding PLID_P2, Mode=OneWay}" HorizontalAlignment="Left" Margin="258,122,0,0" VerticalAlignment="Top" Width="75" Height="20" Command="{Binding Command_EditLatchCommand}" CommandParameter="P2"/>

				<Label x:Name="lblPrimaryPedestal" HorizontalAlignment="Left" Height="45" Margin="118,156,0,-3" VerticalAlignment="Top" Width="60">
					<AccessText TextWrapping="Wrap" Text="Primary Pedestal" TextAlignment="Center"/>
				</Label>
				<Label x:Name="lblSecondaryPedestal" HorizontalAlignment="Left" Height="45" Margin="264,156,0,-3" VerticalAlignment="Top" Width="70">
					<AccessText TextWrapping="Wrap" Text="Secondary Pedestal" TextAlignment="Center"/>
				</Label>
			</Grid>
		</GroupBox>

		<GroupBox x:Name="frmPayload" Header="Payload" HorizontalAlignment="Left" Height="100" Margin="384,10,0,0" VerticalAlignment="Top" Width="230">
			<Grid>
				<Label HorizontalAlignment="Left" Height="26" Margin="10,10,0,0" VerticalAlignment="Top" Width="45" Content="Name"/>
				<Label x:Name="lblPayloadName" HorizontalAlignment="Left" Height="26" Margin="60,10,0,0" VerticalAlignment="Top" Width="150" Content="{Binding Payload.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Background="White"/>
				<Button x:Name="btnEditPayload" Content="Edit Payload" HorizontalAlignment="Left" Height="25" Margin="110,45,0,0" VerticalAlignment="Top" Width="80" Command="{Binding Command_EditPayloadCommand}"/>
			</Grid>
		</GroupBox>
	</Grid>
</Window>
