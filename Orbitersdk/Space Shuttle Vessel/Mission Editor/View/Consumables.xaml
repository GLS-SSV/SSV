<UserControl x:Class="SSVMissionEditor.Consumables"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:SSVMissionEditor"
	mc:Ignorable="d" 
	d:DesignHeight="500" d:DesignWidth="800">
	<Grid>
		<GroupBox Header="Propellant" HorizontalAlignment="Left" Height="323" Margin="10,10,0,0" VerticalAlignment="Top" Width="358">
			<Grid Margin="10,10,10,10">
				<Label Content="Forward RCS" Margin="115,10,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" HorizontalContentAlignment="Center"/>
				<TextBox x:Name="txtFRCS" HorizontalAlignment="Left" Height="24" Margin="115,36,0,0" TextWrapping="Wrap" Text="{Binding Consumables_FRCS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_FRCS_Tooltip, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>

				<Label Content="Left RCS" Margin="15,60,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" HorizontalContentAlignment="Center"/>
				<TextBox x:Name="txtLRCS" HorizontalAlignment="Left" Height="24" Margin="15,85,0,0" TextWrapping="Wrap" Text="{Binding Consumables_LRCS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_ARCS_Tooltip, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>

				<Label Content="Right RCS" Margin="215,60,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" HorizontalContentAlignment="Center"/>
				<TextBox x:Name="txtRRCS" HorizontalAlignment="Left" Height="24" Margin="215,85,0,0" TextWrapping="Wrap" Text="{Binding Consumables_RRCS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_ARCS_Tooltip, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>

				<Label Content="Left OMS" Margin="15,208,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" HorizontalContentAlignment="Center"/>
				<TextBox x:Name="txtLOMS" HorizontalAlignment="Left" Height="24" Margin="15,234,0,0" TextWrapping="Wrap" Text="{Binding Consumables_LOMS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_OMS_Tooltip, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>

				<Label Content="Right OMS" Margin="215,208,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" HorizontalContentAlignment="Center"/>
				<TextBox x:Name="txtROMS" HorizontalAlignment="Left" Height="24" Margin="215,234,0,0" TextWrapping="Wrap" Text="{Binding Consumables_ROMS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_OMS_Tooltip, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>

				<ComboBox x:Name="cmbOMSKitTankSets" ItemsSource="{Binding Consumables_OMSKitTanks_src, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding Consumables_OMSKitTanks, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" HorizontalAlignment="Left" Margin="115,156,0,0" VerticalAlignment="Top" Width="100"/>
				<TextBox x:Name="txtKOMS" HorizontalAlignment="Left" Height="24" Margin="115,183,0,0" TextWrapping="Wrap" Text="{Binding Consumables_KOMS_Load, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Consumables_KOMS_Tooltip, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Consumables_KOMS_Load_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="100"/>
			</Grid>
		</GroupBox>
		<GroupBox Header="PRSD" HorizontalAlignment="Left" Height="125" Margin="414,61,0,0" VerticalAlignment="Top" Width="330">
			<Grid Margin="10,10,10,10">
				<ComboBox x:Name="cmbIntPRSD" ItemsSource="{Binding Consumables_PRSDInternalTanks_src, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding Consumables_PRSDInternalTanks, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="125,0,0,0" VerticalAlignment="Top" Width="160"/>
				<CheckBox x:Name="ckbEDOKit" Content="EDO Kit" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Margin="0,31,0,0" IsChecked="{Binding Consumables_EDOKit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Consumables_EDOKit_ena}"/>
				<ComboBox x:Name="cmbEDOPallet" ItemsSource="{Binding Consumables_EDOPallet_src, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding Consumables_EDOPallet, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Consumables_EDOPallet_ena}" HorizontalAlignment="Left" Margin="95,51,0,0" VerticalAlignment="Top" Width="190"/>

				<Label Content="Internal PRSD tanks" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120"/>
				<Label Content="EDO Pallet" HorizontalAlignment="Left" Margin="0,52,0,0" VerticalAlignment="Top" Width="90"/>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
