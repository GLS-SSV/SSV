<UserControl x:Class="SSVMissionEditor.Landing"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SSVMissionEditor"
	mc:Ignorable="d" 
	d:DesignHeight="500" d:DesignWidth="1000">
	<UserControl.Resources>
		<local:RunwayConverter x:Key="RunwayConverter"/>
	</UserControl.Resources>
	<Grid>
		<GroupBox Header="Landing Site Table" HorizontalAlignment="Left" Height="480" Margin="10,10,0,0" VerticalAlignment="Top" Width="800">
			<Grid>
				<TextBox x:Name="txtLandingSiteOut" Text="{Binding Landing_LST, Mode=OneWay}" HorizontalAlignment="Left" Height="438" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="370" AllowDrop="False" VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Courier New"/>


				<GroupBox Header="Preset" HorizontalAlignment="Left" Height="103" Margin="400,0,0,0" VerticalAlignment="Top" Width="380">
					<Grid>
						<Label x:Name="lblLSLPreset" Content="List Preset" HorizontalAlignment="Left" Margin="8,10,0,0" VerticalAlignment="Top" Width="105"/>
						<ComboBox x:Name="cmbLSListPreset" ItemsSource="{Binding Landing_DefaultLSTableNames, Mode=OneWay}" HorizontalAlignment="Left" Margin="128,15,0,0" VerticalAlignment="Top" Width="230" SelectedIndex="{Binding Landing_DefaultLSidx, UpdateSourceTrigger=PropertyChanged}"/>
						<Button x:Name="btnLoadRunwayPreset" Command="{Binding Landing_SetDefaultLSTCommand}" Content="Load" HorizontalAlignment="Left" Margin="258,50,0,0" VerticalAlignment="Top" Width="100" Height="24"/>
					</Grid>
				</GroupBox>


				<GroupBox Header="Manual Edit" HorizontalAlignment="Left" Height="220" Margin="400,118,0,0" VerticalAlignment="Top" Width="380">
					<Grid>
						<Label x:Name="lblRunwayDB" Content="Runway Database" HorizontalAlignment="Left" Margin="8,16,0,0" VerticalAlignment="Top" Width="105"/>
						<Label x:Name="lblRunwayInfo" Content="Runway Info" HorizontalAlignment="Left" Margin="8,50,0,0" VerticalAlignment="Top" Width="105"/>
						<ComboBox x:Name="cmbLandingSiteDB" ItemsSource="{Binding Landing_Runways, Mode=OneWay}" HorizontalAlignment="Left" Margin="128,16,0,0" VerticalAlignment="Top" Width="230" SelectedIndex="{Binding Landing_LSDBidx, UpdateSourceTrigger=PropertyChanged}"/>
						<TextBox x:Name="txtRunwayInfo" Text="{Binding Landing_RunwayInfo, Mode=OneWay}" HorizontalAlignment="Left" Height="100" Margin="128,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" AllowDrop="False" VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsReadOnlyCaretVisible="True"/>
						<RadioButton x:Name="rbPri" IsChecked="{Binding Landing_ManRW, Converter={StaticResource ResourceKey=RunwayConverter}, ConverterParameter=P}" Content="Primary" HorizontalAlignment="Left" Margin="8,171,0,0" VerticalAlignment="Top" Width="75"/>
						<RadioButton x:Name="rbSec" IsChecked="{Binding Landing_ManRW, Converter={StaticResource ResourceKey=RunwayConverter}, ConverterParameter=S}" Content="Secondary" HorizontalAlignment="Left" Margin="88,171,0,0" VerticalAlignment="Top" Width="75"/>
						<ComboBox x:Name="cmbLSID" HorizontalAlignment="Left" Margin="190,166,0,0" VerticalAlignment="Top" Width="50" SelectedIndex="{Binding Landing_ManLSID, UpdateSourceTrigger=PropertyChanged}"/>
						<Button x:Name="btnSetRunway" Command="{Binding Landing_SetRunwayCommand}" Content="Set" HorizontalAlignment="Left" Margin="258,166,0,0" VerticalAlignment="Top" Width="100" Height="24"/>
					</Grid>
				</GroupBox>
			</Grid>
		</GroupBox>

		<GroupBox Header="Xenon Lights" HorizontalAlignment="Left" Height="251" Margin="815,10,0,0" VerticalAlignment="Top" Width="160">
			<Grid>

				<ComboBox ItemsSource="{Binding Landing_XenonLightsDB_src, Mode=OneWay}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="128" SelectedItem="{Binding Landing_XenonLightDB, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Command="{Binding Landing_NewXenonLightCommand}" Content="New" HorizontalAlignment="Left" Height="25" Margin="10,40,0,0" VerticalAlignment="Top" Width="128"/>
				<Button Command="{Binding Landing_DeleteXenonLightCommand}" Content="Delete" HorizontalAlignment="Left" Height="25" Margin="10,75,0,0" VerticalAlignment="Top" Width="128"/>
				<ListBox HorizontalAlignment="Left" Height="115" Margin="10,105,0,0" VerticalAlignment="Top" Width="128" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding Landing_XenonLightsList, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Landing_XenonLight, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
