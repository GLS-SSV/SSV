<UserControl x:Class="SSVMissionEditor.Orbit"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
	d:DesignHeight="500" d:DesignWidth="800">
	<Grid>
		<GroupBox x:Name="frmOrbitTargeting" Header="Orbit Targeting" HorizontalAlignment="Left" Height="345" Margin="10,10,0,0" VerticalAlignment="Top" Width="375">
			<Grid Margin="10,10,10,10">
				<Label Content="Current Target Set" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="120" Margin="0,2,0,0"/>

				<TextBox x:Name="txtCurSet" Text="{Binding Orbit_CurOrbTgtSet, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="23" Margin="123,2,0,0" VerticalAlignment="Top" Width="217" IsEnabled="False"/>

				<Label Content="New Target Set" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="90" Margin="0,45,0,0"/>

				<ComboBox x:Name="cmbTgtSets" HorizontalAlignment="Left" VerticalAlignment="Top" Width="175" Margin="95,45,0,0" ItemsSource="{Binding Orbit_OrbTgtSets, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbit_SelOrbTgtSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

				<Button x:Name="btnLoadTgtSets" Command="{Binding Orbit_LoadTgtSetsCommand}" Content="Load" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Margin="280,44,0,0" Height="25"/>

				<TextBox x:Name="txtTgtSetsDesc" Text="{Binding Orbit_SelOrbTgtSetDesc, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="180" Margin="0,74,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="340" AllowDrop="False" VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsReadOnlyCaretVisible="True"/>

				<Label Content="Target Vessel" HorizontalAlignment="Left" Height="26" VerticalAlignment="Top" Width="85" Margin="0,275,0,0"/>

				<TextBox x:Name="txtTgtVessel" HorizontalAlignment="Left" Height="23" Margin="90,275,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="165" Text="{Binding Orbit_SelTgtVessel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

				<Button x:Name="btnPickTgtVessel" Command="{Binding Orbit_PickTgtVesselCommand}" Content="Pick Vessel" HorizontalAlignment="Left" Margin="265,274,0,0" VerticalAlignment="Top" Width="75" Height="25"/>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
