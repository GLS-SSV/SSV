<UserControl x:Class="SSVMissionEditor.Orbiter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
	d:DesignHeight="500" d:DesignWidth="800">
	<Grid>
		<Label Content="Orbiter Vehicle:" HorizontalAlignment="Left" Height="26" Margin="25,25,0,0" VerticalAlignment="Top" Width="110"/>
		<Label Content="Texture:" HorizontalAlignment="Left" Height="26" Margin="25,55,0,0" VerticalAlignment="Top" Width="70"/>
		<Label Content="LH OMS Pod Texture:" HorizontalAlignment="Left" Height="26" Margin="25,120,0,0" VerticalAlignment="Top" Width="125"/>
		<Label Content="RH OMS Pod Texture:" HorizontalAlignment="Left" Height="26" Margin="25,150,0,0" VerticalAlignment="Top" Width="125"/>
		<CheckBox x:Name="ckbSILTS" Content="SILTS" HorizontalAlignment="Left" Height="20" Margin="532,25,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" ToolTip="&quot;Shuttle Infrared Leeside Temperature Sensing&quot; camera pod (OV-102 only)" IsChecked="{Binding Orbiter_SILTS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_SILTS_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbFwdBulkDockLights" Content="Fwd Bulkhead and Docking Lights" HorizontalAlignment="Left" Height="20" Margin="532,50,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" ToolTip="Removable only on OV-103 and OV-105" IsChecked="{Binding Orbiter_FwdBulkDockLights, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_FwdBulkDockLights_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbDragChute" Content="Drag Chute" HorizontalAlignment="Left" Height="20" Margin="532,75,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_DragChute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_DragChute_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbKuBandAntenna" Content="Ku-band Antenna" HorizontalAlignment="Left" Height="20" Margin="532,100,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_KubandAntenna, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbPLBLiner" Content="PLB Liner" HorizontalAlignment="Left" Height="20" Margin="532,125,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_PLBLiner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbDFIWireTray" Content="DFI Wire Tray" HorizontalAlignment="Left" Height="20" Margin="532,150,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_DFIWireTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_DFIWireTray_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<CheckBox x:Name="ckbVentDoors4and7" Content="Vent Doors 4 and 7" HorizontalAlignment="Left" Height="20" Margin="532,175,0,0" Grid.Row="1" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_VentDoors4and7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_VentDoors4and7_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

		<ComboBox x:Name="cbOV" HorizontalAlignment="Left" Height="24" Margin="140,25,0,0" VerticalAlignment="Top" Width="160" ItemsSource="{Binding Orbiter_Vehicle_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_Vehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<ComboBox x:Name="cbOVdefaulttexture" HorizontalAlignment="Left" Height="24" Margin="100,55,0,0" VerticalAlignment="Top" Width="90" ItemsSource="{Binding Orbiter_Default_Texture_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_Default_Texture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<TextBox x:Name="txtOVtexture" HorizontalAlignment="Left" Height="24" Margin="205,55,0,0" VerticalAlignment="Top" Width="175" Text="{Binding Orbiter_Texture, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_Texture_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

		<ComboBox x:Name="cbLOMSdefaulttexture" HorizontalAlignment="Left" Height="24" Margin="170,120,0,0" VerticalAlignment="Top" Width="140" ItemsSource="{Binding Orbiter_LOMS_Default_Texture_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_LOMS_Default_Texture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<TextBox x:Name="txtLOMStexture" HorizontalAlignment="Left" Height="24" Margin="325,120,0,0" VerticalAlignment="Top" Width="175" Text="{Binding Orbiter_LOMS_Texture, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_LOMS_Texture_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

		<ComboBox x:Name="cbROMSdefaulttexture" HorizontalAlignment="Left" Height="24" Margin="170,150,0,0" VerticalAlignment="Top" Width="140" ItemsSource="{Binding Orbiter_ROMS_Default_Texture_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_ROMS_Default_Texture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<TextBox x:Name="txtROMStexture" HorizontalAlignment="Left" Height="24" Margin="325,150,0,0" VerticalAlignment="Top" Width="175" Text="{Binding Orbiter_ROMS_Texture, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_ROMS_Texture_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

		<GroupBox Header="Airlock and ODS" HorizontalAlignment="Left" Height="140" Margin="525,215,0,0" VerticalAlignment="Top" Width="265">
			<Grid>
				<CheckBox x:Name="ckbExtAL_ODS_Kit" Content="External Airlock / ODS Kit" HorizontalAlignment="Left" Height="20" Margin="10,10,0,0" VerticalAlignment="Top" Width="210" IsChecked="{Binding Orbiter_ExtAL_ODS_Kit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_ExtAL_ODS_Kit_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

				<Label Content="Airlock:" HorizontalAlignment="Left" Height="26" Margin="10,45,0,0" VerticalAlignment="Top" Width="50"/>
				<ComboBox x:Name="cbAL" HorizontalAlignment="Left" Height="24" Margin="77,45,0,0" VerticalAlignment="Top" Width="90" ItemsSource="{Binding Orbiter_Airlock_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_Airlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_ExtAL_ODS_Kit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

				<CheckBox x:Name="ckbODS" Content="ODS" HorizontalAlignment="Left" Height="20" Margin="183,49,0,0" VerticalAlignment="Top" Width="60" ToolTip="Orbiter Docking System" IsChecked="{Binding Orbiter_ODS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_ExtAL_ODS_Kit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

				<Label Content="TAA:" HorizontalAlignment="Left" Height="26" Margin="10,82,0,0" VerticalAlignment="Top" Width="50"/>
				<ComboBox x:Name="cbTAA" HorizontalAlignment="Left" Height="24" Margin="77,84,0,0" VerticalAlignment="Top" Width="90" ItemsSource="{Binding Orbiter_TAA_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding Orbiter_TAA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</GroupBox>

		<GroupBox Header="Payload Bay CCTV" HorizontalAlignment="Left" Height="140" Margin="25,215,0,0" VerticalAlignment="Top" Width="380">
			<Grid>
				<Label Content="Camera A" HorizontalAlignment="Left" Height="26" Margin="10,45,0,0" VerticalAlignment="Top" Width="65"/>
				<Label Content="Camera B" HorizontalAlignment="Left" Height="26" Margin="200,45,0,0" VerticalAlignment="Top" Width="65"/>
				<Label Content="Camera C" HorizontalAlignment="Left" Height="26" Margin="200,5,0,0" VerticalAlignment="Top" Width="65"/>
				<Label Content="Camera D" HorizontalAlignment="Left" Height="26" Margin="10,5,0,0" VerticalAlignment="Top" Width="65"/>
				<CheckBox x:Name="ckbCCTVA" HorizontalAlignment="Left" Height="20" Margin="80,50,0,0" VerticalAlignment="Top" Width="20" IsChecked="{Binding Orbiter_CCTV_A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				<CheckBox x:Name="ckbCCTVB" HorizontalAlignment="Left" Height="20" Margin="270,50,0,0" VerticalAlignment="Top" Width="20" IsChecked="{Binding Orbiter_CCTV_B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				<CheckBox x:Name="ckbCCTVC" HorizontalAlignment="Left" Height="20" Margin="270,10,0,0" VerticalAlignment="Top" Width="20" IsChecked="{Binding Orbiter_CCTV_C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				<CheckBox x:Name="ckbCCTVD" HorizontalAlignment="Left" Height="20" Margin="80,10,0,0" VerticalAlignment="Top" Width="20" IsChecked="{Binding Orbiter_CCTV_D, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdCCTVA" Content="Edit" HorizontalAlignment="Left" Margin="110,47,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditPLBCameraCommand}" CommandParameter="A" IsEnabled="{Binding Orbiter_CCTV_A, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdCCTVB" Content="Edit" HorizontalAlignment="Left" Margin="300,50,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditPLBCameraCommand}" CommandParameter="B" IsEnabled="{Binding Orbiter_CCTV_B, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdCCTVC" Content="Edit" HorizontalAlignment="Left" Margin="300,7,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditPLBCameraCommand}" CommandParameter="C" IsEnabled="{Binding Orbiter_CCTV_C, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdCCTVD" Content="Edit" HorizontalAlignment="Left" Margin="110,10,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditPLBCameraCommand}" CommandParameter="D" IsEnabled="{Binding Orbiter_CCTV_D, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Label Content="Keel Camera" HorizontalAlignment="Left" Height="26" Margin="10,85,0,0" VerticalAlignment="Top" Width="80"/>
				<ComboBox x:Name="cmbKeelCamera" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Margin="125,86,0,0" IsEnabled="{Binding Orbiter_CCTV_Keel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Orbiter_CCTV_Keel_PLID_src, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding Orbiter_CCTV_Keel_PLID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				<CheckBox x:Name="ckbKeelCamera" HorizontalAlignment="Left" Height="20" Margin="95,90,0,0" VerticalAlignment="Top" Width="20" IsChecked="{Binding Orbiter_CCTV_Keel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</GroupBox>

		<GroupBox Header="Remote Manipulator System" HorizontalAlignment="Left" Height="85" Margin="525,360,0,0" VerticalAlignment="Top" Width="265">
			<Grid>
				<CheckBox x:Name="ckbRMSport" Content="Port" HorizontalAlignment="Left" Height="20" Margin="10,10,0,0" VerticalAlignment="Top" Width="80" IsChecked="{Binding Orbiter_RMSport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_RMSport_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdRMSport" Content="Edit" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditRMSportCommand}" IsEnabled="{Binding Orbiter_RMSport, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<CheckBox x:Name="ckbRMSstbd" Content="Starboard" HorizontalAlignment="Left" Height="20" Margin="150,10,0,0" VerticalAlignment="Top" Width="80" IsChecked="{Binding Orbiter_RMSstbd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Orbiter_RMSstbd_ena, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
				<Button x:Name="cmdRMSstbd" Content="Edit" HorizontalAlignment="Left" Margin="150,35,0,0" VerticalAlignment="Top" Width="50" Command="{Binding Orbiter_EditRMSstbdCommand}" IsEnabled="{Binding Orbiter_RMSstbd, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>
